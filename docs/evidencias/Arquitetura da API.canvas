		{"id":"97988840525a5413","type":"text","text":"PIPELINE\nAdministra a linha de processamento da ingestão de dados.","x":1120,"y":-43,"width":200,"height":115},
		{"id":"112e549414c059f1","type":"text","text":"DOWNLOADER\nÉ responsável por baixar os arquivos das URLs.","x":420,"y":-160,"width":220,"height":117},
		{"id":"8d4f15c8ac37803c","type":"text","text":"PARSER\nÉ responsável por converter o arquivo em dataframes para facilitar a manipulação.","x":420,"y":-13,"width":220,"height":113},
		{"id":"33dfad75a263f20e","type":"text","text":"CRAWLER\nÉ responsável por acessar a página e capturar as URLs.","x":420,"y":-320,"width":220,"height":127},
		{"id":"e65706e6d8a8b68e","type":"text","text":"NORMALIZER\nÉ responsável por normalizar os dados.","x":420,"y":140,"width":220,"height":120},
		{"id":"ea1ac7c6aead74e6","type":"text","text":"VALIDATOR\nÉ responsável por verificar se há dados novos no arquivo ou não. Se não, os dados não serão inseridos no banco de dados.","x":420,"y":308,"width":220,"height":115},
